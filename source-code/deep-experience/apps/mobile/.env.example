# Mobile app environment variables.
# Expo inlines EXPO_PUBLIC_* vars at build time and exposes them to the JS bundle.
# For native production builds, prefer EAS Secrets over committing values.

# Backend API base URL — full path including /api/v1 suffix.
# Examples:
#   Local dev (default fallback when unset): http://localhost:8001/api/v1
#   Staging: https://deep-experience-staging.vercel.app/api/v1
#   Production: https://deep-experience.vercel.app/api/v1
# EXPO_PUBLIC_API_BASE_URL="https://<your-backend>.vercel.app/api/v1"

# Google Maps JavaScript API key (used on web only).
# Restrict by HTTP referer in the Google Cloud Console.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""
