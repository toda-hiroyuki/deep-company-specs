# --- Database (PostgreSQL on Supabase) ---
# Runtime queries go through the Supabase Pooler (PgBouncer, port 6543).
# Use ?pgbouncer=true&connection_limit=1 for serverless to avoid connection-pool exhaustion.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (non-pooled) URL for migrations. Required by Prisma's directUrl.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
JWT_SECRET="dev-secret-change-in-production"

# --- Storage ---
# "local" = filesystem under public/uploads (dev only — Vercel filesystem is ephemeral)
# "supabase" = Supabase Storage bucket (production)
STORAGE_PROVIDER="local"

# Supabase Storage settings (required when STORAGE_PROVIDER=supabase).
# SUPABASE_URL: project URL, e.g. https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: service role key (server-side only, never expose to clients)
# SUPABASE_STORAGE_BUCKET: bucket name (must exist as a public bucket)
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="tour-media"

# --- Google Maps (guest web) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Web URLs ---
# API base URL (guest web - relative path for same-origin, or full URL for cross-origin)
# NEXT_PUBLIC_API_BASE_URL="/api/v1"

# Site URL (used for OGP, canonical URLs)
# NEXT_PUBLIC_SITE_URL="http://localhost:8001"

# --- Cron / Batch ---
# Cron shared secret (Vercel Cron auto-attaches this as Authorization: Bearer)
# Required in production; optional in dev (batch can be triggered without auth).
# CRON_SECRET=""

# FINALIZE rollout toggle: set to "false" to disable the TENTATIVE→FINALIZED
# batch and on-read guards without reverting code (see docs/business-rules.md §7).
# Default (unset) = enabled.
# FINALIZE_GUARD_ENABLED="true"

# --- SendGrid (メール送信) ---
# 未設定の場合は開発環境用にコンソールへ出力
# SENDGRID_API_KEY=""
# SENDGRID_FROM_EMAIL="noreply@deepexperience.jp"
